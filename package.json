{
  "name": "@dsh-ppt/dsh-ppt-fusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that fuses pptwise's DSH-native front end with ppt-master's native DrawingML engine",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "dsh-ppt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "themes:record": "node --import tsx tests/themes-record.ts",
    "themes:verify": "node --import tsx tests/themes-verify.ts",
    "fixtures:record": "node --import tsx tests/fixtures-record.ts",
    "fixtures:verify": "node --import tsx tests/fixtures-verify.ts",
    "engine:lock": "uv pip compile python-assets/requirements.in --output-file python-assets/requirements.lock --generate-hashes --python-version 3.13 --index-url https://pypi.tuna.tsinghua.edu.cn/simple",
    "opc:check": "node scripts/opc-invariants.mjs",
    "com:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win-com-smoke.ps1",
    "dsh-ppt": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@liustack/pptwise": "0.35.0",
    "commander": "^13.1.0",
    "jszip": "3.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
